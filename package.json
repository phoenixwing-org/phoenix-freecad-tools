{
  "name": "@phoenix-wing/phoenix-freecad-mcp",
  "version": "0.4.1",
  "description": "Phoenix 的 Node.js/TypeScript FreeCAD MCP 服务",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phoenixwing-org/phoenix-freecad-tools.git"
  },
  "homepage": "https://github.com/phoenixwing-org/phoenix-freecad-tools#readme",
  "bugs": {
    "url": "https://github.com/phoenixwing-org/phoenix-freecad-tools/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "phoenix-freecad-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs",
    "addon/PhoenixFreeCADTools/*.py",
    "addon/PhoenixFreeCADTools/package.xml",
    "scripts/*.mjs",
    "addon/PhoenixFreeCADTools/Resources/icons/*.svg",
    "examples/*.py",
    "scripts/package-addon.py",
    "addon/PhoenixFreeCADTools/HELP.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "check": "node dist/cli.js --check",
    "prepack": "npm run build",
    "demo": "node dist/cli.js --demo",
    "addon:install": "node scripts/install-addon.mjs",
    "addon:dev": "node scripts/dev-freecad.mjs",
    "addon:uninstall": "node scripts/uninstall-addon.mjs",
    "test:python": "python3 -m unittest discover -s tests/python -v",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "call": "node scripts/call-tool.mjs",
    "addon:pack": "python3 scripts/package-addon.py",
    "desk:pack": "node scripts/package-desk-resource.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
