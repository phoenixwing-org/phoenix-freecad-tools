# 示例仅说明环境变量；程序不会自动读取 .env 文件。
PHOENIX_FREECAD_URL=http://127.0.0.1:9876/
PHOENIX_TIMEOUT_MS=15000

# 可选 Desk 业务只读 MCP；取消注释前核实三个已有路径。
# 不会自动读取 FreeCAD 偏好、启动 Desk、下载或构建资源。
# PHOENIX_DESK_NODE=/absolute/path/to/node
# PHOENIX_DESK_CLI=/absolute/path/to/desk/scripts/desk-web-service.mjs
# PHOENIX_DESK_STATE_DIR=/absolute/path/to/private-desk-state
# chat 模式默认不开放 Desk；仅明确选用时设置 1（默认/0 关闭）。
# PHOENIX_DESK_CHAT_READS=1
